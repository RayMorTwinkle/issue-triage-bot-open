{
  "name": "issue-triage-bot-web",
  "private": true,
  "version": "3.0.0",
  "description": "issue-triage-bot 控制台（Vite + React + Tailwind）",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:replay",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "build:replay": "vite build --config replay.config.ts && python3 ../demo.py --record ../web/dist/replay/recordings.json"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
